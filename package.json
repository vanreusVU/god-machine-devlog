{
  "name": "god-machine-devlog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "check:content": "node scripts/check-content.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests docs *.json *.ts index.html README.md .github"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
